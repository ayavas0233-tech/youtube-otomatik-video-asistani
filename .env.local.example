# OpenAI API anahtarı. Senaryo ve TTS özellikleri için gereklidir.
OPENAI_API_KEY=

# Google Cloud > APIs & Services > Credentials bölümündeki OAuth 2.0 bilgileri.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth-callback

# OAuth yönlendirmeleri için uygulamanın temel adresi.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Token şifreleme için 32-byte (64 hex karakter) anahtar.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Video çıktılarının kaydedileceği dizin (varsayılan: /tmp/videos).
VIDEO_OUTPUT_DIR=/tmp/videos

# İsteğe bağlı mock YouTube URL'si. Gerçek YouTube yüklemesi sağlamaz.
# YOUTUBE_MOCK_BASE_URL=http://localhost:3000/mock-youtube
