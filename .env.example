import OpenAI from "openai";

export async function POST(request: Request) {
  const payload = await request.json();

  const title = payload.title || "Yapay Zeka ile Kâr Edin";
  const topic = payload.topic || "Güncel AI iş fırsatları";
  const audience = payload.audience || "Yeni başlayan girişimciler";
  const tone = payload.tone || "Motivasyonlu ve net";
  const duration = payload.duration || "6 dakika";
  const voice = payload.voice || "Turkish Female 01";

  try {
    const apiKey = process.env.OPENAI_API_KEY;

    if (!apiKey) {
      return Response.json(buildFallback(title, topic, audience, tone, duration, voice));
    }

    const client = new OpenAI({ apiKey });

    const completion = await client.chat.completions.create({
      model: "gpt-4o-mini",
      temperature: 0.7,
      messages: [
        {
          role: "system",
          content:
            "Sen Türkçe video üretim için yaratıcı, teknik ve net rehberlik yapan bir AI asistanısın. Verilen başlık, konu, hedef kitle, ton ve süre için JSON döndür. Sadece uygun JSON döndür; açıklama ekleme.",
        },
        {
          role: "user",
          content: `Başlık: ${title}\nKonu: ${topic}\nHedef kitle: ${audience}\nTon: ${tone}\nSüre: ${duration}\nSes: ${voice}\n\nAşağıdaki alanları doldur: title, headline, summary, stages (array of {name,status,detail}), script (string[]), thumbnailPrompt, youtubeTitle.`,
        },
      ],
      response_format: { type: "json_object" },
    });

    const content = completion.choices[0]?.message?.content;

    if (!content) {
      return Response.json(buildFallback(title, topic, audience, tone, duration, voice));
    }

    const parsed = JSON.parse(content);

    return Response.json({
      title: parsed.title || title,
      headline: parsed.headline || `${title} için AI üretim planı hazır`,
      summary: parsed.summary || `Tema: ${topic} · Hedef: ${audience} · Ton: ${tone} · Süre: ${duration}`,
      stages: parsed.stages || buildFallback(title, topic, audience, tone, duration, voice).stages,
      script: parsed.script || buildFallback(title, topic, audience, tone, duration, voice).script,
      thumbnailPrompt:
        parsed.thumbnailPrompt ||
        `Modern teknoloji teması, Türkçe metin, ${topic}, YouTube thumbnail, yüksek kontrast, profesyonel görünüm`,
      youtubeTitle: parsed.youtubeTitle || `${title} | ${topic} (${duration})`,
    });
  } catch (error) {
    console.error("AI generation failed", error);
    return Response.json(buildFallback(title, topic, audience, tone, duration, voice));
  }
}

function buildFallback(
  title: string,
  topic: string,
  audience: string,
  tone: string,
  duration: string,
  voice: string,
) {
  return {
    title,
    headline: `${title} için AI üretim planı hazır`,
    summary: `Tema: ${topic} · Hedef: ${audience} · Ton: ${tone} · Süre: ${duration}`,
    stages: [
      { name: "AI Senaryosu", status: "Tamamlandı", detail: "Başlık, giriş ve ana fikirler hazır." },
      { name: "TTS", status: "Hazır", detail: `Türkçe ses akışı tanımlandı: ${voice}` },
      { name: "Görseller", status: "Planlandı", detail: "Görsel düzeni ve başlık kartı hazırlandı." },
      { name: "FFmpeg", status: "Bekliyor", detail: "Video birleştirme ve montaj planı hazırlanıyor." },
      { name: "Altyazı", status: "Bekliyor", detail: "Altyazı ve süre eşleştirme bekleniyor." },
      { name: "Thumbnail", status: "Bekliyor", detail: "YouTube kapağı için tasarım oluşturulacak." },
    ],
    script: [
      "Giriş: İzleyici için hızlı ve güçlü bir tanıtım cümlesi kurulur.",
      "Sorun: Ziyaretçinin karşılaştığı engel ve ihtiyaç net ifade edilir.",
      "Çözüm: Yapay zeka ve sistem yaklaşımı adım adım anlatılır.",
      "Örnek: Uygulama örnekleri ve kısa case çalışmaları eklenir.",
      "Kapanış: CTA ve takip adımı net şekilde ifade edilir.",
    ],
    thumbnailPrompt: `Modern teknoloji teması, Türkçe metin, ${topic}, YouTube thumbnail, yüksek kontrast, profesyonel görünüm`,
    youtubeTitle: `${title} | ${topic} (${duration})`,
  };
}
