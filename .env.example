# =========================================================
# OpenAI (AI senaryo, görsel ve TTS için)
# =========================================================
OPENAI_API_KEY=

# =========================================================
# Google / YouTube OAuth
# =========================================================
# Google Cloud Console'da OAuth 2.0 Client ID (Web application) oluşturun
# ve YouTube Data API v3'ü etkinleştirin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud Console'daki "Authorized redirect URIs" ile birebir eşleşmeli.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth-callback

# =========================================================
# Token Encryption (ZORUNLU)
# =========================================================
# YouTube OAuth token'ları sunucuda AES-256-GCM ile şifrelenerek saklanır.
# 32 byte (64 hex karakter) bir anahtar üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# =========================================================
# Application
# =========================================================
# Uygulamanın dışarıdan erişilen tam URL'si. OAuth redirect'leri ve varsayılan
# GOOGLE_REDIRECT_URI bu değere göre hesaplanır. Üretimde gerçek domain'i
# (https:// ile) kullanın.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NODE_ENV=production olduğunda OAuth state cookie'si "secure" olarak
# işaretlenir; HTTPS arkasında dağıtın.
