# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_VOICE_TR_FEMALE=
ELEVENLABS_VOICE_TR_MALE=
ELEVENLABS_VOICE_NEUTRAL=

# Google OAuth / YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth-callback
GOOGLE_REFRESH_TOKEN=
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload

# Storage / limits
UPLOAD_DIR=tmp/video-jobs
MAX_VIDEO_SIZE=536870912

# Video render options
FFMPEG_PATH=ffmpeg
FFMPEG_PRESET=veryfast
VIDEO_RESOLUTION=1920x1080
VIDEO_BITRATE=3500k
AUDIO_BITRATE=192k

# Features
ENABLE_YOUTUBE_UPLOAD=true
ENABLE_IMAGE_GENERATION=true
TTS_ALLOW_EMPTY_FALLBACK=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
